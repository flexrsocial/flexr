<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Basis-Theme der Activity. Die eigentliche Gestaltung liegt komplett in
        Compose (FlexrTheme) — dieses Theme setzt nur die Fensterfarben, damit
        beim Start kein weißes Aufblitzen entsteht.

        Die beiden Leistenfarben sind ab Android 15 wirkungslos (dort ist die
        randlose Anzeige erzwungen). Bis Android 14 machen nur sie die Leisten
        durchsichtig, seit 2.7.35 ohne die eingestellten Aufrufe
        Window.setStatusBarColor/setNavigationBarColor (siehe
        MainActivity.drawBehindSystemBars).
    -->
    <style name="Theme.Flexr" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- Splashscreen nach Android-12-Standard (androidx.core:core-splashscreen). -->
    <style name="Theme.Flexr.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Flexr</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
