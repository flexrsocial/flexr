<?xml version="1.0" encoding="utf-8"?>
<!--
    FLEXR-Hantel — pixelgenau aus dem im Play Store hinterlegten Icon
    (android/store_icon.png, 512x512) vermessen und als Vektor nachgebaut:
    zwei schmale äußere Scheiben, zwei breite innere Scheiben und ein
    durchgehender Steg über die volle Breite, alle mit runden Enden.

    Umrechnung 512er-Vorlage -> 108dp-Adaptive-Icon-Fläche mit Faktor 0.175,
    zentriert auf (54,54). Der Inhalt bleibt damit vollständig innerhalb der
    66dp-Sicherheitszone, wird also von keiner Launcher-Maske angeschnitten.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- äußere Scheiben -->
    <path
        android:pathData="M29.5,37.29 V70.71 M78.5,37.29 V70.71"
        android:strokeColor="#FFFF5A1F"
        android:strokeWidth="4.38"
        android:strokeLineCap="round" />

    <!-- innere Scheiben -->
    <path
        android:pathData="M40,29.59 V78.41 M68,29.59 V78.41"
        android:strokeColor="#FFFF5A1F"
        android:strokeWidth="8.93"
        android:strokeLineCap="round" />

    <!-- durchgehender Steg -->
    <path
        android:pathData="M26.44,54 H81.56"
        android:strokeColor="#FFFF5A1F"
        android:strokeWidth="5.08"
        android:strokeLineCap="round" />
</vector>
