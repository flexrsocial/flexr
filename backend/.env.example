# Datenbank
DATABASE_URL=postgresql://postgres:flexr@localhost:5432/flexr

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...      # 10€/Monat-Preis fuer FLEXR Premium in Stripe anlegen

# Ist FLEXR Premium schon kaufbar? Waehrend der Beta-Phase steht das bewusst auf
# false: Dann ist fuer alle alles unbegrenzt, /api/billing/checkout lehnt mit
# 409 ab, und die Grenzen fuer Standardkonten greifen noch nicht.
#
# **Die Nutzung von FLEXR ist unabhaengig davon dauerhaft kostenlos.** Dieser
# Schalter entscheidet nur ueber das freiwillige Zusatzpaket - eine Bezahlwand
# gibt es seit dem 10.09.2026 nicht mehr.
PREMIUM_ENABLED=false

# Preis und Grenzen. Die Zahlen stehen wortgleich in der Oberflaeche, auf der
# Landingpage und in den AGB - wer sie aendert, aendert eine Zusage.
# PREMIUM_PRICE_CENTS=1000
# FREE_DAILY_LIKES=20
# FREE_OPEN_CHATS=3
# FREE_MAX_RADIUS_KM=50

# STRIPE_TRIAL_DAYS und BILLING_ENABLED sind entfallen (kein Probemonat, keine
# Bezahlwand mehr). Alte Eintraege in einer bestehenden .env schaden nicht -
# unbekannte Schluessel werden ueberlesen, siehe backend/app/config.py.

# Objekt-Storage (S3-kompatibel, z. B. Cloudflare R2) für Foto-Uploads.
# S3_ENDPOINT_URL bleibt der echte R2-Endpunkt - dorthin lädt der Browser
# per Presigned PUT direkt hoch.
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=flexr-photos
# S3_PUBLIC_BASE_URL zeigt seit dem 16.08.2026 NICHT mehr auf R2, sondern auf
# den eigenen Ursprung: Der öffentliche R2-Testhost (pub-<id>.r2.dev) blockte
# ausgerechnet Bild-Einbettungen von flexr.social selbst mit HTTP 403 -
# Cloudflare führt ihn ausdrücklich als nicht für Produktionsbetrieb gedacht.
# Die Location /photos/ in deploy/nginx-flexr.conf holt das Objekt jetzt
# server-seitig von R2 (dort steht der tatsächliche R2-Host fest im
# proxy_pass, nicht hier). Siehe tools/check_csp_hosts.py.
S3_PUBLIC_BASE_URL=https://flexr.social/photos
S3_REGION=auto

# E-Mail-Versand (Bestätigungs-, Rücktritts- und Melde-Mails). Ohne
# SMTP_HOST/SMTP_FROM wird die Mail nur ins Server-Log geschrieben - der
# auslösende Vorgang (Registrierung, Rücktritt, ...) läuft trotzdem durch.
# Anbieter: Brevo, siehe frontend/datenschutz.html Abschnitt 6.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASSWORD=...
SMTP_FROM=noreply@flexr.social
SMTP_STARTTLS=true          # false + SMTP_SSL=true für Port 465
SMTP_SSL=false
MAIL_FROM_NAME=FLEXR
SUPPORT_EMAIL=flexr.social@proton.me

# App
FRONTEND_URL=https://flexr.social
ENV=development

# Telegram-Push ans Admin-Team bei neuen Admin-Dashboard-Aufgaben
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
